#!/usr/bin/env bash
set -euo pipefail

#MISE description="Configure kubeconfig to use yc-k8s-token for Kubernetes authentication"
#USAGE arg "[kubeconfig]" \
#USAGE   help="Path to the kubeconfig file" \
#USAGE   default="~/icloud/.kubeconfig"

KUBECONFIG="${usage_kubeconfig?}"

# Expand "~" because usage passes the value literally.
KUBECONFIG="${KUBECONFIG/#\~/$HOME}"

if [[ ! -f "$KUBECONFIG" ]]; then
  echo "error: kubeconfig not found: $KUBECONFIG" >&2
  exit 1
fi

if ! command -v yq > /dev/null 2>&1; then
  echo "error: yq is not installed or not in PATH" >&2
  exit 1
fi

yq -i '
  (.users[].user.exec |= (
    .command = "yc-k8s-token" |
    .args = []
  ))
' "$KUBECONFIG"

echo "Updated kubeconfig: $KUBECONFIG"
