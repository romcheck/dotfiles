#!/usr/bin/env bash
set -euo pipefail

#MISE description="Set multiple Pulumi secrets from a key=value file"
#USAGE arg "<config-file>" \
#USAGE   help="Path to a file containing secret key=value pairs"

CONFIG_FILE="${usage_config_file?}"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "error: config file not found: $CONFIG_FILE" >&2
  exit 1
fi

if [[ ! -r "$CONFIG_FILE" ]]; then
  echo "error: config file is not readable: $CONFIG_FILE" >&2
  exit 1
fi

if ! command -v pulumi > /dev/null 2>&1; then
  echo "error: pulumi is not installed or not in PATH" >&2
  exit 1
fi

args=()

echo "Reading secrets from $CONFIG_FILE..."

while IFS='=' read -r key value || [[ -n "$key" ]]; do
  # Trim leading/trailing whitespace from the key.
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"

  # Skip empty lines and comments.
  [[ -z "$key" || "$key" == \#* ]] && continue

  args+=(--secret --path "$key=$value")

  echo "  -> Prepared: $key"
done < "$CONFIG_FILE"

if [[ ${#args[@]} -eq 0 ]]; then
  echo "No valid secrets found in '$CONFIG_FILE'."
  exit 0
fi

echo
echo "Applying ${#args[@]} Pulumi secrets..."

pulumi config set-all "${args[@]}"

echo "Successfully set ${#args[@]} Pulumi secrets."
