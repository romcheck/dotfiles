#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

echo "🚀 Starting yadm bootstrap..."

# --- 0. Prepare iCloud Symlink ---
# Using a symlink simplifies paths and avoids issues with spaces in iCloud path
ICLOUD_ORIGINAL="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
ICLOUD_LINK="$HOME/icloud"

if [ ! -L "$ICLOUD_LINK" ]; then
    echo "🔗 Creating iCloud symlink..."
    ln -s "$ICLOUD_ORIGINAL" "$ICLOUD_LINK"
else
    echo "✅ iCloud symlink already exists."
fi

# --- 1. Path & Requirement Checks ---
echo "🔍 Verifying cloud paths..."
CUSTOM_KEYCHAIN="$ICLOUD_LINK/envchain.keychain-db"
SSH_KEY="$ICLOUD_LINK/.id_rsa"

if [ ! -f "$CUSTOM_KEYCHAIN" ]; then
    echo "❌ Error: Keychain not found at $CUSTOM_KEYCHAIN"
    exit 1
fi

if [ ! -f "$SSH_KEY" ]; then
    echo "❌ Error: SSH Key not found at $SSH_KEY"
    exit 1
fi

# --- 2. Homebrew Installation ---
if ! command -v brew >/dev/null 2>&1; then
    echo "🍺 Homebrew not found. Installing via official .pkg..."
    
    INSTALLER_URL="https://github.com/Homebrew/brew/releases/latest/download/Homebrew.pkg"
    PKG_PATH="/tmp/Homebrew.pkg"
    
    curl -L "$INSTALLER_URL" -o "$PKG_PATH"
    
    echo "🔐 Please enter your password for Homebrew installation:"
    sudo installer -pkg "$PKG_PATH" -target /
    rm "$PKG_PATH"

    # Set up shell environment for current session (Apple Silicon)
    eval "$(/opt/homebrew/bin/brew shellenv)"
    echo "✅ Homebrew installed."
else
    echo "✅ Homebrew is already installed."
fi

# --- 3. macOS System Settings (defaults) ---
echo "⚙️  Applying macOS system settings..."

# Scrolling & Fonts
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
defaults -currentHost write -g AppleFontSmoothing -int 0

# Dock
defaults write com.apple.dock tilesize -int 72
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock show-recents -bool false

# Finder
defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Trackpad & Keyboard
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write com.apple.applemultitouchtrackpad Clicking -bool true
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 15

# Caps Lock to Ctrl (Internal Keyboard)
defaults write -g com.apple.keyboard.modifiermapping.1452-630-0 -array '<dict><key>HIDKeyboardModifierMappingDst</key><integer>30064771300</integer><key>HIDKeyboardModifierMappingSrc</key><integer>30064771129</integer></dict>'

# --- 4. Keychain & SSH Integration ---
echo "🔐 Integrating secrets and keys..."

# Resolve the real path to handle symlinks correctly for comparison
REAL_CUSTOM_PATH=$(readlink -f "$CUSTOM_KEYCHAIN")

# Read current keychains into array, cleaning up quotes and spaces
mapfile -t KEYCHAINS < <(security list-keychains -d user | sed 's/^[[:space:]]*"//;s/"[[:space:]]*$//')

# Check if it already exists using wildcard matching (ShellCheck friendly)
if [[ " ${KEYCHAINS[*]} " == *"${REAL_CUSTOM_PATH}"* ]]; then
    echo "✅ Keychain already in search list."
else
    echo "🔗 Adding envchain.keychain-db to current list..."
    # We append to existing list instead of overwriting, keeping OpenVPN etc.
    KEYCHAINS+=("$REAL_CUSTOM_PATH")
    security list-keychains -d user -s "${KEYCHAINS[@]}"
fi

echo "🔑 Adding SSH key to agent..."
ssh-add --apple-use-keychain "$SSH_KEY"

# --- 5. Homebrew Permissions & Bundle ---
if command -v brew >/dev/null 2>&1; then
    BREW_SHARE="$(brew --prefix)/share"

    # Check if 'group' or 'others' have write access (the BSD way)
    # stat -f %Lp returns permissions in octal (e.g., 775)
    # We check if the last two digits are greater than 5 (meaning 6 or 7, which is write access)
    PERMS=$(stat -f "%Lp" "$BREW_SHARE")
    if [[ "$PERMS" =~ [0-9][6-7][0-9] ]] || [[ "$PERMS" =~ [0-9][0-9][6-7] ]]; then
        echo "🛡️  Securing Homebrew permissions..."
        sudo chmod -R go-w "$BREW_SHARE"
    else
        echo "✅ Homebrew permissions are already secure ($PERMS)."
    fi

    if [ -f "$HOME/Brewfile" ]; then
        echo "📦 Installing software from Brewfile..."
        brew bundle --file="$HOME/Brewfile"
    fi
fi

# --- 6. Path to the PAM sudo configuration ---
PAM_FILE="/etc/pam.d/sudo"
TOUCHID_LINE="auth       sufficient     pam_tid.so"

# Check if the line already exists to avoid duplicates
if ! grep -q "pam_tid.so" "$PAM_FILE"; then
    echo "Enabling Touch ID for sudo..."

    # Use sed to insert the line at the top (after the first line comment)
    # This requires sudo because /etc/pam.d/ is system-protected
    sudo sed -i '' "2i\\
$TOUCHID_LINE
" "$PAM_FILE"

    echo "Touch ID enabled successfully."
else
    echo "Touch ID for sudo is already configured."
fi

# --- 7. Finalization ---
echo "🔄 Restarting UI processes..."
killall Finder Dock SystemUIServer > /dev/null 2>&1 || true

echo "✅ Bootstrap complete! Your environment is ready."
