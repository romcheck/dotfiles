#!/usr/bin/env bash

set -euo pipefail

# ==========================================================
# Preflight
# ==========================================================

[[ "$(uname -s)" == "Darwin" ]] || {
  echo "❌ This bootstrap is macOS-only."
  exit 1
}

[[ "$(uname -m)" == "arm64" ]] || {
  echo "❌ Apple Silicon is required."
  exit 1
}

# Apple Silicon Homebrew
export HOMEBREW_PREFIX="/opt/homebrew"
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"

PKG_PATH=""
FINDER_PREFS_TMP=""

cleanup() {
  [[ -z "${PKG_PATH:-}" ]] || rm -f "$PKG_PATH"
  [[ -z "${FINDER_PREFS_TMP:-}" ]] || rm -f "$FINDER_PREFS_TMP"
}

trap cleanup EXIT

echo "🚀 Starting yadm bootstrap..."

# ==========================================================
# iCloud Symlink
# ==========================================================

ICLOUD_ORIGINAL="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
ICLOUD_LINK="$HOME/icloud"

if [[ -L "$ICLOUD_LINK" ]]; then

  if [[ -d "$ICLOUD_LINK" ]]; then
    echo "✅ iCloud symlink already exists."
  else
    echo "❌ iCloud symlink is broken: $ICLOUD_LINK"
    exit 1
  fi

elif [[ -e "$ICLOUD_LINK" ]]; then

  echo "❌ $ICLOUD_LINK exists but is not a symlink."
  exit 1

else

  [[ -d "$ICLOUD_ORIGINAL" ]] || {
    echo "❌ iCloud Drive is not available."
    exit 1
  }

  echo "🔗 Creating iCloud symlink..."
  ln -s "$ICLOUD_ORIGINAL" "$ICLOUD_LINK"

fi

# ==========================================================
# Keychain & SSH Integration
# ==========================================================

echo "🔍 Verifying cloud paths..."

SSH_KEYS=(
  "$ICLOUD_LINK/.id_rsa"
  "$ICLOUD_LINK/.id_ed25519"
)

# Verify all configured private keys
for SSH_KEY in "${SSH_KEYS[@]}"; do

  if [[ ! -f "$SSH_KEY" ]]; then
    echo "❌ SSH Key not found at $SSH_KEY"
    exit 1
  fi

  # Secure private key permissions
  chmod 600 "$SSH_KEY"

done

echo "🔑 Loading SSH identities from macOS Keychain..."

/usr/bin/ssh-add --apple-load-keychain || {
  echo "ℹ️ No Keychain identities loaded. Checking configured keys..."
}

# Check whether a key is already present in the agent
agent_has_key() {
  local key="$1"
  local fingerprint
  local loaded_fingerprints

  fingerprint="$(
    /usr/bin/ssh-keygen -lf "$key" | awk '{print $2}'
  )"

  loaded_fingerprints="$(
    /usr/bin/ssh-add -l 2> /dev/null \
      | awk '{print $2}' || true
  )"

  grep -Fxq "$fingerprint" <<< "$loaded_fingerprints"
}

# Add any configured key not yet loaded
for SSH_KEY in "${SSH_KEYS[@]}"; do

  if agent_has_key "$SSH_KEY"; then

    echo "✅ Already loaded: $(basename "$SSH_KEY")"

  else

    echo "🔐 Adding $(basename "$SSH_KEY") to Keychain and SSH agent..."

    /usr/bin/ssh-add --apple-use-keychain "$SSH_KEY"

  fi

done

echo "✅ SSH identities configured."

# ==========================================================
# Homebrew Installation
# ==========================================================

BREW="$HOMEBREW_PREFIX/bin/brew"

if [[ ! -x "$BREW" ]]; then

  echo "🍺 Homebrew not found. Installing via official .pkg..."

  INSTALLER_URL="https://github.com/Homebrew/brew/releases/latest/download/Homebrew.pkg"

  PKG_PATH="$(mktemp "${TMPDIR:-/tmp}/Homebrew.XXXXXX")"

  curl -fLsS --retry 3 \
    "$INSTALLER_URL" \
    -o "$PKG_PATH"

  echo "🔐 Verifying Homebrew package signature..."
  pkgutil --check-signature "$PKG_PATH"

  echo "🔐 Installing Homebrew..."
  sudo installer -pkg "$PKG_PATH" -target /

  echo "✅ Homebrew installed."

fi

# Initialize Homebrew environment
eval "$("$BREW" shellenv)"

# Explicitly preserve the expected prefix
export HOMEBREW_PREFIX="/opt/homebrew"

echo "✅ Homebrew ready."

# ==========================================================
# macOS System Settings
# ==========================================================

echo "⚙️ Applying macOS system settings..."

# ----------------------------------------------------------
# Scrolling & Fonts
# ----------------------------------------------------------

defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false

defaults -currentHost write -g AppleFontSmoothing -int 0

# ----------------------------------------------------------
# Dock
# ----------------------------------------------------------

defaults write com.apple.dock tilesize -int 72
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock show-recents -bool false

# ----------------------------------------------------------
# Finder
# ----------------------------------------------------------

echo "🧭 Configuring Finder..."

# Prevent Finder from overwriting preferences during configuration
osascript -e 'tell application "Finder" to quit' > /dev/null 2>&1 || true
sleep 1

# General settings
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Default View: List
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

# Search results: List
defaults write com.apple.finder FXPreferredSearchViewStyle -string "Nlsv"

# Group By: None
defaults write com.apple.finder FXPreferredGroupBy -string "None"
defaults write com.apple.finder FXArrangeGroupViewBy -string "None"

# Folders first in Finder windows
defaults write com.apple.finder _FXSortFoldersFirst -bool true

# Folders first on Desktop
defaults write com.apple.finder _FXSortFoldersFirstOnDesktop -bool true

# ----------------------------------------------------------
# Finder: Sort by Name
# ----------------------------------------------------------

echo "📂 Configuring Finder sorting..."

FINDER_PREFS_TMP="$(mktemp "${TMPDIR:-/tmp}/Finder.XXXXXX.plist")"

defaults export com.apple.finder "$FINDER_PREFS_TMP"

# Ensure a dictionary exists in the exported plist
plist_ensure_dict() {
  local path="$1"

  if ! /usr/libexec/PlistBuddy \
    -c "Print $path" "$FINDER_PREFS_TMP" > /dev/null 2>&1; then

    /usr/libexec/PlistBuddy \
      -c "Add $path dict" "$FINDER_PREFS_TMP" > /dev/null

  fi
}

# Set a string, creating the key if necessary
plist_set_string() {
  local path="$1"
  local value="$2"

  if ! /usr/libexec/PlistBuddy \
    -c "Set $path $value" "$FINDER_PREFS_TMP" > /dev/null 2>&1; then

    /usr/libexec/PlistBuddy \
      -c "Add $path string $value" "$FINDER_PREFS_TMP" > /dev/null

  fi
}

# Standard and extended Finder view settings
for ROOT in StandardViewSettings FK_StandardViewSettings; do

  plist_ensure_dict ":$ROOT"

  # List View: sort by Name
  for VIEW_SETTINGS in ExtendedListViewSettingsV2 ListViewSettings; do

    plist_ensure_dict ":$ROOT:$VIEW_SETTINGS"

    plist_set_string \
      ":$ROOT:$VIEW_SETTINGS:sortColumn" \
      "name"

  done

  # Icon View: arrange by Name
  plist_ensure_dict ":$ROOT:IconViewSettings"

  plist_set_string \
    ":$ROOT:IconViewSettings:arrangeBy" \
    "name"

done

# Desktop Icon View: arrange by Name
plist_ensure_dict ":DesktopViewSettings"
plist_ensure_dict ":DesktopViewSettings:IconViewSettings"

plist_set_string \
  ":DesktopViewSettings:IconViewSettings:arrangeBy" \
  "name"

# Import updated Finder preferences
defaults import com.apple.finder "$FINDER_PREFS_TMP"

rm -f "$FINDER_PREFS_TMP"
FINDER_PREFS_TMP=""

# ----------------------------------------------------------
# Finder: Optional complete View reset
# ----------------------------------------------------------

if [[ "${YADM_RESET_FINDER_VIEWS:-0}" == "1" ]]; then

  echo "🧹 Resetting folder-specific Finder settings..."

  if [[ "${YADM_KEEP_DESKTOP_LAYOUT:-0}" == "1" ]]; then

    echo "   Preserving Desktop icon layout..."

    DELETED_COUNT="$(
      find "$HOME" \
        -type f \
        -name ".DS_Store" \
        ! -path "$HOME/Desktop/.DS_Store" \
        -print -delete 2> /dev/null \
        | wc -l | tr -d ' ' || true
    )"

  else

    DELETED_COUNT="$(
      find "$HOME" \
        -type f \
        -name ".DS_Store" \
        -print -delete 2> /dev/null \
        | wc -l | tr -d ' ' || true
    )"

  fi

  echo "✅ Removed $DELETED_COUNT .DS_Store files."

else

  echo "⏭️ Skipping .DS_Store cleanup."

fi

# ----------------------------------------------------------
# Trackpad & Keyboard
# ----------------------------------------------------------

echo "⌨️ Configuring keyboard and trackpad..."

defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true

defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true

defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 15

# Caps Lock → Control (Internal Keyboard)
defaults -currentHost write -g \
  com.apple.keyboard.modifiermapping.1452-630-0 \
  -array '<dict><key>HIDKeyboardModifierMappingDst</key><integer>30064771300</integer><key>HIDKeyboardModifierMappingSrc</key><integer>30064771129</integer></dict>'

# ==========================================================
# Homebrew Bundle
# ==========================================================

if [[ -f "$HOME/Brewfile" ]]; then

  echo "📦 Installing software from Brewfile..."

  brew bundle --file="$HOME/Brewfile"

fi

# ==========================================================
# Touch ID for sudo
# ==========================================================

echo "🔐 Configuring Touch ID for sudo..."

PAM_FILE="/etc/pam.d/sudo"
PAM_LOCAL="/etc/pam.d/sudo_local"
PAM_TEMPLATE="/etc/pam.d/sudo_local.template"

# Check that the system PAM configuration supports sudo_local
if grep -Eq \
  '^[[:space:]]*auth[[:space:]]+include[[:space:]]+sudo_local([[:space:]]|$)' \
  "$PAM_FILE" \
  || grep -Eq \
    '^[[:space:]]*#[[:space:]]*include[[:space:]]+sudo_local([[:space:]]|$)' \
    "$PAM_FILE"; then

  # Skip if Touch ID is already configured
  if grep -Eq \
    '^[[:space:]]*auth[[:space:]].*pam_tid\.so' \
    "$PAM_LOCAL" 2> /dev/null; then

    echo "✅ Touch ID is already configured."

  else

    # Preserve existing local configuration before modifying it
    if [[ -e "$PAM_LOCAL" ]]; then

      PAM_BACKUP="${PAM_LOCAL}.yadm-backup-$(date +%Y%m%d-%H%M%S)"

      echo "📋 Backing up existing PAM configuration..."
      sudo cp -p "$PAM_LOCAL" "$PAM_BACKUP"

    elif [[ -f "$PAM_TEMPLATE" ]]; then

      echo "📋 Creating local PAM configuration from Apple template..."
      sudo cp -p "$PAM_TEMPLATE" "$PAM_LOCAL"

    else

      echo "📋 Creating local PAM configuration..."

      printf '%s\n' \
        "# Local sudo configuration managed by yadm" \
        "auth       sufficient     pam_tid.so" \
        | sudo tee "$PAM_LOCAL" > /dev/null

    fi

    # Uncomment Apple's template line if present
    if grep -Eq \
      '^[[:space:]]*#[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so' \
      "$PAM_LOCAL"; then

      sudo /usr/bin/sed -E -i '' \
        's/^[[:space:]]*#[[:space:]]*(auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so.*)$/\1/' \
        "$PAM_LOCAL"

    # Otherwise append the configuration
    elif ! grep -Eq \
      '^[[:space:]]*auth[[:space:]].*pam_tid\.so' \
      "$PAM_LOCAL"; then

      printf '\nauth       sufficient     pam_tid.so\n' \
        | sudo tee -a "$PAM_LOCAL" > /dev/null

    fi

    # Verify the resulting configuration
    if grep -Eq \
      '^[[:space:]]*auth[[:space:]].*pam_tid\.so' \
      "$PAM_LOCAL"; then

      echo "✅ Touch ID enabled successfully."

    else

      echo "❌ Could not verify Touch ID PAM configuration."
      exit 1

    fi

  fi

else

  echo "⚠️ sudo_local is not included in the system PAM configuration."
  echo "   Skipping Touch ID configuration."

fi

# ==========================================================
# SOPS Completion
# ==========================================================

echo "🔧 Configuring SOPS completion..."

CORRECT_COMPLETION="$HOME/.config/yadm/files/_sops"

if [[ -f "$CORRECT_COMPLETION" ]]; then

  BREW_COMPLETION="$HOMEBREW_PREFIX/share/zsh/site-functions/_sops"

  mkdir -p "$(dirname "$BREW_COMPLETION")"

  cp "$CORRECT_COMPLETION" "$BREW_COMPLETION"

  echo "✅ SOPS completion installed."

fi

# ==========================================================
# Finalization
# ==========================================================

echo "🔄 Restarting UI processes..."

killall Finder Dock > /dev/null 2>&1 || true

open -a Finder

echo "✅ Bootstrap complete! Your environment is ready."
