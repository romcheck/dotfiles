set vicmd=hx
set trashdir=~/.Trash
set incsearch
set ignorecase
set vifminfo+=savedirs
set wildmenu
set mouse=a
set nofollowlinks

only

mark h ~/
mark z ~/.config/vifm vifmrc
mark d ~/Downloads
mark D ~/Documents
mark i ~/icloud
mark l "~/Library/Application Support/OpenVPN Connect/profiles"

colorscheme onedark

filetype {*.pdf,*.jpg,*.jpeg,*.png} open -a preview.app
filetype {*.doc,*.docx,*.pages} open -a Pages\ Creator\ Studio
filetype {*.xls,*.xlsx,*.numbers} open -a Numbers\ Creator\ Studio
filetype {*.mkv,*.mov} open -a iina.app

nnoremap I cw<c-a>
nnoremap cc cw<c-u>
nnoremap A cw
map s :shell<cr>
map ы :shell<cr>
map q :quit<cr>
map й :quit<cr>

nnoremap <C-n> :set sort=name<cr>
nnoremap <C-t> :set sort=mtime<cr>
nnoremap <C-s> :set sort=size<cr>
nnoremap <C-o> :invert o<cr>
