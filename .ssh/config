# --- Specific Host Configurations ---
# These are matched first. If a match is found, these settings take priority.
Host git*
    User git

# --- Global Defaults ---
# These apply to ALL hosts unless overridden above.
Host *
    # Use the macOS Keychain to store and retrieve passphrases
    UseKeychain yes
    
    # Automatically load the key into the SSH agent when used
    AddKeysToAgent yes
    
    # Enable agent forwarding (use with caution)
    ForwardAgent yes
    
    # Automatically add new host keys to the known_hosts file
    StrictHostKeyChecking accept-new
    
    # Compatibility for older servers using RSA/SHA1 (Legacy support)
    HostkeyAlgorithms +ssh-rsa
    PubkeyAcceptedKeyTypes +ssh-rsa
